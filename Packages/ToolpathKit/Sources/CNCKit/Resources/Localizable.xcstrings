          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blok, kontrolcünün desteklemediği bir G-code komutu içeriyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该程序段包含控制器不支持的 G 代码命令。"
          }
        }
      }
    },
    "The chip load was held inside the safe range for this material, so very small or very large bits don't get an unrealistic bite.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُبقي حمل الرايش ضمن النطاق الآمن لهذه الخامة، كي لا تأخذ اللقم الصغيرة جدًا أو الكبيرة جدًا عضّة غير واقعية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zahnvorschub wurde im sicheren Bereich für dieses Material gehalten, damit sehr kleine oder große Fräser keinen unrealistischen Biss bekommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga de viruta se mantuvo en el rango seguro para este material, para que fresas muy pequeñas o grandes no tengan un mordisco poco realista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il carico truciolo è stato mantenuto nell'intervallo sicuro per questo materiale, così frese molto piccole o grandi non prendono un morso irrealistico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この材料の安全範囲に刃当たり送りを収めたので、極端に小さい・大きいビットでも非現実的な食い込みになりません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагрузка на зуб удержана в безопасном диапазоне для этого материала, чтобы очень маленькие или большие фрезы не получали нереальный съём."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talaş yükü bu malzeme için güvenli aralıkta tutuldu; çok küçük veya çok büyük uçlar gerçek dışı bir yük almaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每齿进给量保持在该材料的安全范围内，避免很小或很大的刀具出现不切实际的吃刀量。"
          }
        }
      }
    },
    "The command is missing a required P or L value.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينقص الأمر قيمة P أو L مطلوبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Befehl fehlt ein erforderlicher P- oder L-Wert."
          }
        },
