    "Toolpath flags this before you run: look for a 'No feed rate' warning.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُشير Toolpath إلى ذلك قبل التشغيل: ابحث عن تحذير «لم تُضبط سرعة تغذية»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolpath markiert das vor dem Start: Achte auf die Warnung „Kein Vorschub gesetzt“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolpath lo marca antes de ejecutar: busca la advertencia «Sin avance definido»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolpath lo segnala prima dell'avvio: cerca l'avviso «Nessun avanzamento impostato»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolpathは実行前にこれを検出します。「送りが未設定」の警告を確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolpath отмечает это до запуска: ищите предупреждение «Подача не задана»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolpath bunu çalıştırmadan önce işaretler: 'İlerleme hızı ayarlanmamış' uyarısına bak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolpath 会在运行前标出此问题：留意“未设置进给速度”警告。"
          }
        }
      }
    },
    "Two axis commands": {
