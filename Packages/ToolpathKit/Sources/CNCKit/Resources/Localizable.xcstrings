          }
        }
      }
    },
    "Enable homing with $22=1 if your machine has homing switches.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الإرجاع للصفر بـ $22=1 إذا كانت آلتك تحتوي مفاتيح إرجاع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere die Referenzfahrt mit $22=1, wenn deine Maschine Referenzschalter hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el homing con $22=1 si tu máquina tiene finales de carrera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilita l'homing con $22=1 se la macchina ha i finecorsa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原点スイッチがあるマシンなら $22=1 で原点復帰を有効にしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите хоуминг командой $22=1, если на станке есть концевики."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makinende referans switch'leri varsa $22=1 ile referanslamayı aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果机器有回零开关，请用 $22=1 启用回零。"
          }
        }
      }
    },
