    "Start the probe closer to the plate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ المجس أقرب إلى اللوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte das Antasten näher an der Platte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza el palpado más cerca de la placa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la tastatura più vicino alla piastra."
          }
        },
        "ja": {
