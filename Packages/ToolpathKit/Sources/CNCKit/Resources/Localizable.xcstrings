          }
        }
      }
    },
    "Step pulse time must be greater than 3 µs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون زمن نبضة الخطوة أكبر من 3 ميكروثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schrittimpulsdauer muss größer als 3 µs sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de pulso de paso debe ser mayor de 3 µs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La durata dell'impulso di passo deve superare 3 µs."
          }
        },
        "ja": {
          "stringUnit": {
