          "stringUnit": {
            "state": "translated",
            "value": "命令缺少必需的 P 或 L 值。"
          }
        }
      }
    },
    "The command needs X, Y or Z words but none were found.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج الأمر كلمات X أو Y أو Z لكن لم يُعثر على أي منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl braucht X-, Y- oder Z-Worte, aber keine wurden gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando necesita palabras X, Y o Z, pero no se encontró ninguna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando richiede parole X, Y o Z ma non ne sono state trovate."
          }
        },
