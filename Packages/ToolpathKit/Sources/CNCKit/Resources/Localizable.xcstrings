          }
        }
      }
    },
    "Homing is not enabled in settings ($22).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإرجاع للصفر غير مفعّل في الإعدادات ($22)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Referenzfahrt ist in den Einstellungen nicht aktiviert ($22)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El homing no está activado en los ajustes ($22)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'homing non è abilitato nelle impostazioni ($22)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で原点復帰が有効になっていません($22)。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хоуминг не включён в настройках ($22)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarda referanslama etkin değil ($22)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置中未启用回零（$22）。"
          }
        }
      }
    },
    "If it happened mid-job, check the file's bounds against your work zero — the job may be larger than the space you left.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا حدث ذلك أثناء العمل، قارن حدود الملف بصفر القطعة — قد يكون العمل أكبر من المساحة التي تركتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passierte es mitten im Job, prüfe die Dateigrenzen gegen deinen Nullpunkt – der Job ist evtl. größer als der freie Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si pasó a mitad del trabajo, compara los límites del archivo con tu cero: el trabajo puede ser más grande que el espacio que dejaste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se è successo a metà lavoro, confronta i limiti del file con lo zero: il lavoro potrebbe essere più grande dello spazio lasciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業途中で起きた場合は、ファイルの範囲をワーク原点と照合してください。空けたスペースより作業が大きい可能性があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это случилось посреди работы, сверьте границы файла с нулём — работа может быть больше оставленного места."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşin ortasında olduysa dosyanın sınırlarını iş sıfırına göre kontrol et — iş bıraktığın alandan büyük olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果发生在加工中途，请将文件边界与工件零点对照 — 加工可能比预留空间大。"
          }
        }
      }
    },
    "If your machine has no homing switches, disable homing ($22=0).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم تكن في آلتك مفاتيح إرجاع، عطّل الإرجاع ($22=0)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat deine Maschine keine Referenzschalter, deaktiviere die Referenzfahrt ($22=0)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu máquina no tiene finales de carrera, desactiva el homing ($22=0)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la macchina non ha finecorsa, disattiva l'homing ($22=0)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原点スイッチがない場合は原点復帰を無効にしてください($22=0)。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если на станке нет концевиков, отключите хоуминг ($22=0)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makinende referans switch'i yoksa referanslamayı kapat ($22=0)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果机器没有回零开关，请禁用回零（$22=0）。"
          }
        }
      }
    },
    "If your router is switched by hand, turn it on before starting and confirm it here. Otherwise add M3 with a speed (e.g. M3 S18000) before the first cut, or enable spindle output in your post processor.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان الراوتر يُشغَّل يدويًا، شغّله قبل البدء وأكّد ذلك هنا. وإلا أضف M3 مع سرعة (مثل M3 S18000) قبل أول قطع، أو فعّل مخرج عمود الدوران في المعالج اللاحق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird deine Oberfräse von Hand geschaltet, schalte sie vor dem Start ein und bestätige es hier. Andernfalls füge vor dem ersten Schnitt M3 mit Drehzahl hinzu (z. B. M3 S18000) oder aktiviere die Spindelausgabe im Postprozessor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu fresadora se enciende a mano, enciéndela antes de empezar y confírmalo aquí. Si no, añade M3 con velocidad (p. ej., M3 S18000) antes del primer corte o activa la salida del husillo en tu postprocesador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il router si accende a mano, accendilo prima di avviare e confermalo qui. Altrimenti aggiungi M3 con una velocità (es. M3 S18000) prima del primo taglio o abilita l'uscita mandrino nel post-processore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーターを手動で入れる場合は、開始前に電源を入れてここで確認してください。そうでなければ最初の切削前に回転数付きのM3(例: M3 S18000)を追加するか、ポストプロセッサでスピンドル出力を有効にしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если фрезер включается вручную, включите его перед запуском и подтвердите здесь. Иначе добавьте M3 со скоростью (например, M3 S18000) перед первым проходом или включите вывод шпинделя в постпроцессоре."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Freze motorun elle açılıyorsa başlatmadan önce aç ve burada onayla. Aksi halde ilk kesimden önce hızla birlikte M3 ekle (ör. M3 S18000) ya da post işlemcide iş mili çıkışını etkinleştir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果雕刻电机是手动开关的，请在开始前打开并在此确认。否则在第一次切削前加入带转速的 M3（例如 M3 S18000），或在后处理器中启用主轴输出。"
          }
        }
      }
    },
    "Increase the homing pull-off ($27), e.g. to 2–3 mm.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زِد مسافة الرجوع بعد الإرجاع ($27)، مثلًا إلى 2–3 مم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe den Freifahrweg ($27), z. B. auf 2–3 mm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta la retirada de homing ($27), p. ej., a 2–3 mm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta il ritorno dall'homing ($27), es. a 2–3 mm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原点復帰の引き戻し量($27)を2〜3 mmなどに増やしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличьте отъезд после хоуминга ($27), например до 2–3 мм."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans geri çekilme mesafesini ($27) artır, ör. 2–3 mm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增加回零退回距离（$27），例如 2–3 mm。"
          }
        }
      }
    },
    "Integer required": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب عدد صحيح"
          }
