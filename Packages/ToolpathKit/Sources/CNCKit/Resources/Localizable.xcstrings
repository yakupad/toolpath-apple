          "stringUnit": {
            "state": "translated",
            "value": "G53 需要 G0 或 G1 运动模式。"
          }
        }
      }
    },
    "GRBL refuses these moves with error 22; other controllers may use an unexpected default speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرفض GRBL هذه الحركات بـ error 22؛ وقد تستخدم وحدات تحكم أخرى سرعة افتراضية غير متوقعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GRBL lehnt diese Bewegungen mit error 22 ab; andere Steuerungen nutzen evtl. eine unerwartete Standardgeschwindigkeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GRBL rechaza estos movimientos con error 22; otros controladores pueden usar una velocidad por defecto inesperada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GRBL rifiuta questi movimenti con error 22; altri controller possono usare una velocità predefinita inattesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GRBLはこれらの移動を error 22 で拒否します。他のコントローラは予期しない既定速度を使うことがあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GRBL отклоняет такие перемещения с error 22; другие контроллеры могут использовать неожиданную скорость по умолчанию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GRBL bu hareketleri error 22 ile reddeder; diğer kontrolcüler beklenmedik bir varsayılan hız kullanabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GRBL 会以 error 22 拒绝这些移动；其他控制器可能使用意外的默认速度。"
          }
        }
      }
    },
    "Hard limit triggered": {
      "localizations": {
