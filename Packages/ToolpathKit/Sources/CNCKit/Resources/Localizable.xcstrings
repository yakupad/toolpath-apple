          "stringUnit": {
            "state": "translated",
            "value": "只支持 G54–G59。"
          }
        }
      }
    },
    "Prefer I/J arc output in your CAM post instead of R.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فضّل إخراج الأقواس بصيغة I/J بدل R في معالج CAM اللاحق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevorzuge im CAM-Postprozessor I/J-Bögen statt R."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el postprocesador del CAM, prefiere arcos I/J en lugar de R."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel post-processore CAM preferisci archi I/J invece di R."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CAMのポストではRではなくI/J形式の円弧を選んでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В постпроцессоре CAM выбирайте дуги I/J вместо R."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CAM post işlemcinde R yerine I/J yay çıktısını tercih et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 CAM 后处理中优先输出 I/J 圆弧而不是 R。"
          }
        }
      }
    },
    "Probe fail: no contact": {
      "localizations": {
