    "Settings memory could not be read; defaults were restored.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة ذاكرة الإعدادات؛ استُعيدت القيم الافتراضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungsspeicher nicht lesbar; Standardwerte wurden wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la memoria de ajustes; se restauraron los valores predeterminados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la memoria impostazioni; ripristinati i valori predefiniti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定メモリを読み込めず、既定値に戻しました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать память настроек; восстановлены значения по умолчанию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayar belleği okunamadı; varsayılanlar geri yüklendi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取设置存储；已恢复默认值。"
          }
        }
      }
    },
    "Settings read failed": {
      "localizations": {
        "ar": {
          "stringUnit": {
