{
  "sourceLanguage": "en",
  "strings": {
    "%lld cutting moves run before any M3/M4 spindle start. The first is on line %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$lld حركة قطع تعمل قبل أي تشغيل لعمود الدوران بـ M3/M4. أولها في السطر %2$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Schnittbewegungen laufen vor jedem M3/M4-Spindelstart. Die erste steht in Zeile %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld cutting moves run before any M3/M4 spindle start. The first is on line %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld movimientos de corte se ejecutan antes de arrancar el husillo con M3/M4. El primero está en la línea %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld movimenti di taglio partono prima di qualsiasi avvio del mandrino M3/M4. Il primo è alla riga %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "M3/M4でスピンドルを起動する前に%1$lld件の切削移動があります。最初は%2$lld行目です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочих перемещений до запуска шпинделя M3/M4: %1$lld. Первое — в строке %2$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kesim hareketi M3/M4 iş mili başlatmasından önce çalışıyor. İlki %2$lld. satırda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$lld 个切削移动在 M3/M4 启动主轴之前执行。第一个在第 %2$lld 行。"
          }
        }
      }
    },
    "%lld cutting moves run without a feed rate (F). The first is on line %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$lld حركة قطع تعمل دون سرعة تغذية (F). أولها في السطر %2$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Schnittbewegungen laufen ohne Vorschub (F). Die erste steht in Zeile %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld cutting moves run without a feed rate (F). The first is on line %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld movimientos de corte se ejecutan sin avance (F). El primero está en la línea %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld movimenti di taglio partono senza avanzamento (F). Il primo è alla riga %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送り(F)なしの切削移動が%1$lld件あります。最初は%2$lld行目です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочих перемещений без подачи (F): %1$lld. Первое — в строке %2$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kesim hareketi ilerleme hızı (F) olmadan çalışıyor. İlki %2$lld. satırda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$lld 个切削移动没有进给速度（F）。第一个在第 %2$lld 行。"
          }
        }
      }
    },
    "%lld moves end outside your machine's travel, measured from machine zero. The first is on line %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$lld حركة تنتهي خارج مدى حركة آلتك مقيسًا من صفر الآلة. أولها في السطر %2$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Bewegungen enden außerhalb des Verfahrwegs deiner Maschine, gemessen vom Maschinennullpunkt. Die erste steht in Zeile %2$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld moves end outside your machine's travel, measured from machine zero. The first is on line %2$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld movimientos terminan fuera del recorrido de tu máquina, medido desde el cero máquina. El primero está en la línea %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld movimenti terminano fuori dalla corsa della macchina, misurata dallo zero macchina. Il primo è alla riga %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン原点から測ってストローク外で終わる移動が%1$lld件あります。最初は%2$lld行目です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещений, заканчивающихся за пределами ходов станка (от нуля станка): %1$lld. Первое — в строке %2$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld hareket, makine sıfırından ölçüldüğünde hareket alanının dışında bitiyor. İlki %2$lld. satırda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$lld 个移动的终点超出机器行程（以机床原点计）。第一个在第 %2$lld 行。"
          }
        }
      }
    },
    "%lld rapid moves go below the stock top. The first is on line %lld, dropping from Z%@ to Z%@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$lld حركة سريعة تنزل تحت سطح الخامة. أولها في السطر %2$lld، وتنزل من Z%3$@ إلى Z%4$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Eilgänge gehen unter die Materialoberkante. Der erste steht in Zeile %2$lld und fällt von Z%3$@ auf Z%4$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld rapid moves go below the stock top. The first is on line %2$lld, dropping from Z%3$@ to Z%4$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld movimientos rápidos bajan de la superficie del material. El primero está en la línea %2$lld y baja de Z%3$@ a Z%4$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld movimenti rapidi scendono sotto la superficie del materiale. Il primo è alla riga %2$lld e scende da Z%3$@ a Z%4$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料上面より下に入る早送りが%1$lld件あります。最初は%2$lld行目で、Z%3$@からZ%4$@まで下がります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Холостых ходов ниже верха заготовки: %1$lld. Первый — в строке %2$lld, опускается с Z%3$@ до Z%4$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld hızlı hareket malzeme yüzeyinin altına iniyor. İlki %2$lld. satırda, Z%3$@ değerinden Z%4$@ değerine düşüyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$lld 个快速移动低于材料上表面。第一个在第 %2$lld 行，从 Z%3$@ 降到 Z%4$@。"
          }
        }
      }
    },
    "%lld rapid moves travel sideways at only Z%@, below %@ mm. The first is on line %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%1$lld حركة سريعة تتحرك جانبيًا على ارتفاع Z%2$@ فقط، تحت %3$@ مم. أولها في السطر %4$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Eilgänge fahren seitlich auf nur Z%2$@, unter %3$@ mm. Der erste steht in Zeile %4$lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld rapid moves travel sideways at only Z%2$@, below %3$@ mm. The first is on line %4$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld movimientos rápidos se desplazan de lado a solo Z%2$@, por debajo de %3$@ mm. El primero está en la línea %4$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld movimenti rapidi si spostano lateralmente a solo Z%2$@, sotto %3$@ mm. Il primo è alla riga %4$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わずかZ%2$@(%3$@ mm未満)で横移動する早送りが%1$lld件あります。最初は%4$lld行目です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Холостых ходов в сторону на высоте всего Z%2$@, ниже %3$@ мм: %1$lld. Первый — в строке %4$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld hızlı hareket yalnızca Z%2$@ yüksekliğinde, %3$@ mm altında yanlamasına gidiyor. İlki %4$lld. satırda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %1$lld 个快速移动仅在 Z%2$@（低于 %3$@ mm）横向移动。第一个在第 %4$lld 行。"
          }
        }
      }
    },
    "A G-code word is missing its letter.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة G-code ينقصها الحرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einem G-Code-Wort fehlt der Buchstabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A una palabra de G-code le falta la letra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A una parola G-code manca la lettera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "G-codeワードに文字がありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В слове G-code нет буквы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir G-code kelimesinin harfi eksik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个 G 代码字缺少字母。"
          }
        }
      }
    },
    "A G-code word is repeated on one line.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة G-code مكررة في سطر واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein G-Code-Wort wird in einer Zeile wiederholt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palabra de G-code se repite en una línea."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parola G-code è ripetuta sulla stessa riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行内でG-codeワードが重複しています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слово G-code повторяется в одной строке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir G-code kelimesi aynı satırda tekrar ediyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一行中某个 G 代码字重复。"
          }
        }
      }
    },
    "A G2/G3 arc has no axis words in the selected plane.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوس G2/G3 بلا كلمات محاور في المستوى المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein G2/G3-Bogen hat keine Achsworte in der gewählten Ebene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arco G2/G3 no tiene palabras de eje en el plano seleccionado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arco G2/G3 non ha parole d'asse nel piano selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "G2/G3円弧に選択平面の軸ワードがありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У дуги G2/G3 нет слов осей в выбранной плоскости."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir G2/G3 yayının seçili düzlemde eksen kelimesi yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "G2/G3 圆弧在所选平面中没有轴字。"
          }
        }
      }
    },
    "A command requires an integer value.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الأمر قيمة صحيحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Befehl erfordert einen ganzzahligen Wert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando requiere un valor entero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando richiede un valore intero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドに整数値が必要です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда требует целое значение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir komut tam sayı değer gerektiriyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令需要整数值。"
          }
        }
      }
    },
    "A cutting move was sent before any feed rate (F).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسلت حركة قطع قبل تحديد أي سرعة تغذية (F)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Schnittbewegung wurde vor jedem Vorschub (F) gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envió un movimiento de corte antes de cualquier avance (F)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato inviato un movimento di taglio prima di qualsiasi avanzamento (F)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送り(F)を設定する前に切削移動が送られました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочее перемещение отправлено до задания подачи (F)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir ilerleme hızından (F) önce kesim hareketi gönderildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置进给速度（F）之前发送了切削移动。"
          }
        }
      }
    },
    "A jog target exceeds machine travel and was ignored.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هدف التحريك اليدوي يتجاوز مدى الآلة وتم تجاهله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tippbetrieb-Ziel überschreitet den Verfahrweg und wurde ignoriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un destino de jog supera el recorrido de la máquina y se ignoró."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un obiettivo di jog supera la corsa della macchina ed è stato ignorato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジョグの目標がストロークを超えたため無視されました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель толчкового перемещения выходит за ходы станка и проигнорирована."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir jog hedefi makine hareket alanını aşıyor ve yok sayıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点动目标超出机器行程，已忽略。"
          }
        }
      }
    },
    "A light profiling pass engages less of the bit, so it can take a 30% heavier chip.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرور المحيط الخفيف يعشّق جزءًا أقل من اللقمة، لذا يتحمل رايشًا أسمك بنسبة 30 ٪."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leichter Konturschnitt greift weniger vom Fräser an und verträgt einen 30 % dickeren Span."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pasada ligera de contorno engancha menos la fresa, así que admite una viruta un 30 % más gruesa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una passata leggera di contornatura impegna meno la fresa, quindi può prendere un truciolo più spesso del 30 %."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軽い輪郭加工は工具の接触が少ないので、30%厚い切りくずを取れます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкий контурный проход нагружает фрезу меньше, поэтому допускает стружку на 30 % толще."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif bir profil pasosu ucun daha azını kavrar, bu yüzden %30 daha kalın talaş alabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻量轮廓加工的刀具吃刀较少，因此切屑可以厚 30%。"
          }
        }
      }
    },
    "A limit switch was hit during motion. Machine position is likely lost.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اصطدم مفتاح نهاية أثناء الحركة. على الأرجح فُقد موضع الآلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Bewegung wurde ein Endschalter ausgelöst. Die Maschinenposition ist wahrscheinlich verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activó un final de carrera durante el movimiento. Probablemente se perdió la posición de la máquina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un finecorsa è scattato durante il movimento. La posizione della macchina è probabilmente persa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動中にリミットスイッチが作動しました。マシン位置はおそらく失われています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время движения сработал концевик. Положение станка, скорее всего, потеряно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareket sırasında bir limit switch tetiklendi. Makine konumu büyük olasılıkla kayboldu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运动中触发了限位开关。机器位置很可能已丢失。"
          }
        }
      }
    },
    "A line exceeds the maximum length and was not executed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سطر يتجاوز الطول الأقصى ولم يُنفَّذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile überschreitet die Maximallänge und wurde nicht ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea supera la longitud máxima y no se ejecutó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga supera la lunghezza massima e non è stata eseguita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行が最大長を超えたため実行されませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка длиннее максимальной и не выполнена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir satır azami uzunluğu aşıyor ve çalıştırılmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某行超过最大长度，未执行。"
          }
        }
      }
    },
    "A move in the program targets a position outside the machine's configured travel. Position is kept; it is safe to unlock.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حركة في البرنامج تستهدف موضعًا خارج مدى الحركة المضبوط. الموضع محفوظ والفتح آمن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bewegung im Programm zielt außerhalb des eingestellten Verfahrwegs. Die Position bleibt erhalten; Entsperren ist sicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un movimiento del programa apunta fuera del recorrido configurado. La posición se conserva; es seguro desbloquear."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un movimento del programma punta fuori dalla corsa configurata. La posizione è mantenuta; sbloccare è sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラム内の移動が設定ストロークの外を指しています。位置は保持されており、ロック解除は安全です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещение в программе ведёт за пределы заданных ходов станка. Положение сохранено; разблокировать безопасно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programdaki bir hareket makinenin ayarlı hareket alanının dışını hedefliyor. Konum korunur; kilidi açmak güvenlidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "程序中的某个移动目标超出机器设定行程。位置已保留，可以安全解锁。"
          }
        }
      }
    },
    "A negative value was given where a positive one is required.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُعطيت قيمة سالبة حيث تلزم قيمة موجبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein negativer Wert wurde angegeben, wo ein positiver nötig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se indicó un valor negativo donde se requiere uno positivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato dato un valore negativo dove ne serve uno positivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値が必要な箇所に負の値が指定されました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрицательное значение там, где требуется положительное."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozitif değer gereken yerde negatif değer verildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在需要正值的地方给出了负值。"
          }
        }
      }
    },
    "A number is missing or badly formatted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رقم مفقود أو بتنسيق خاطئ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zahl fehlt oder ist falsch formatiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta un número o tiene un formato incorrecto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un numero manca o ha un formato errato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値がないか、形式が正しくありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число отсутствует или записано неверно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sayı eksik veya hatalı biçimde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字缺失或格式错误。"
          }
        }
      }
    },
    "A setting exceeds the maximum supported step rate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد يتجاوز أقصى معدل خطوات مدعوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einstellung überschreitet die maximale Schrittrate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ajuste supera la frecuencia de pasos máxima admitida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'impostazione supera la frequenza di passi massima supportata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定が最大ステップレートを超えています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка превышает максимальную частоту шагов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ayar desteklenen azami adım hızını aşıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某项设置超过支持的最大步进频率。"
          }
        }
      }
    },
    "A stationary bit pushed into material breaks almost instantly. Machines with a manual router need it switched on by hand before Start.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللقمة الثابتة إذا دُفعت في الخامة تنكسر فورًا تقريبًا. الآلات ذات الراوتر اليدوي تحتاج تشغيله يدويًا قبل البدء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein stehender Fräser, der ins Material gedrückt wird, bricht fast sofort. Bei Maschinen mit manueller Oberfräse muss sie vor dem Start von Hand eingeschaltet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fresa parada empujada contra el material se rompe casi al instante. En máquinas con fresadora manual, hay que encenderla a mano antes de iniciar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fresa ferma spinta nel materiale si rompe quasi subito. Sulle macchine con router manuale va accesa a mano prima dell'avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "止まったビットを材料に押し付けるとほぼ即座に折れます。手動ルーターのマシンでは開始前に手で電源を入れる必要があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподвижная фреза, вдавленная в материал, ломается почти мгновенно. На станках с ручным фрезером его нужно включить вручную до запуска."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönmeyen bir uç malzemeye bastırılınca neredeyse anında kırılır. Manuel freze motorlu makinelerde motor Başlat'tan önce elle açılmalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静止的刀具压入材料几乎会立即折断。手动雕刻电机的机器需要在开始前手动开启。"
          }
        }
      }
    },
    "Add an F value before the first G1/G2/G3, or re-export from CAM.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف قيمة F قبل أول G1/G2/G3 أو أعد التصدير من CAM."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge vor dem ersten G1/G2/G3 einen F-Wert hinzu oder exportiere neu aus dem CAM."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un valor F antes del primer G1/G2/G3 o vuelve a exportar desde el CAM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un valore F prima del primo G1/G2/G3 o riesporta dal CAM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のG1/G2/G3の前にF値を追加するか、CAMから再出力してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте значение F перед первым G1/G2/G3 или заново экспортируйте из CAM."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk G1/G2/G3'ten önce bir F değeri ekle ya da CAM'den yeniden dışa aktar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在第一个 G1/G2/G3 前添加 F 值，或从 CAM 重新导出。"
          }
        }
      }
    },
    "Add an F value before the first cutting move, or re-export from CAM with feed rates enabled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف قيمة F قبل أول حركة قطع أو أعد التصدير من CAM مع تفعيل سرعات التغذية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge vor der ersten Schnittbewegung einen F-Wert hinzu oder exportiere aus dem CAM mit aktivierten Vorschüben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un valor F antes del primer movimiento de corte o vuelve a exportar desde el CAM con avances activados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un valore F prima del primo movimento di taglio o riesporta dal CAM con gli avanzamenti attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の切削移動の前にF値を追加するか、送りを有効にしてCAMから再出力してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте значение F перед первым рабочим перемещением или экспортируйте из CAM с включёнными подачами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk kesim hareketinden önce bir F değeri ekle ya da CAM'den ilerleme hızları açık olarak yeniden dışa aktar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在第一个切削移动前添加 F 值，或在 CAM 中启用进给速度后重新导出。"
          }
        }
      }
    },
    "After touching a limit switch the axis could not pull off far enough to release it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد لمس مفتاح النهاية لم يستطع المحور الرجوع بما يكفي لتحريره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Berühren eines Endschalters konnte die Achse nicht weit genug zurückfahren, um ihn freizugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras tocar un final de carrera, el eje no pudo retirarse lo suficiente para liberarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver toccato un finecorsa l'asse non è riuscito ad arretrare abbastanza da liberarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リミットスイッチに触れた後、軸が解放できるほど戻れませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После касания концевика ось не смогла отъехать достаточно, чтобы его отпустить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksen limit switch'e dokunduktan sonra onu bırakacak kadar geri çekilemedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触碰限位开关后，轴无法退回足够距离来释放它。"
          }
        }
      }
    },
    "An I/J arc is missing its offset word in the selected plane.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوس I/J ينقصه كلمة الإزاحة في المستوى المحدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einem I/J-Bogen fehlt das Versatzwort in der gewählten Ebene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A un arco I/J le falta la palabra de desplazamiento en el plano seleccionado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A un arco I/J manca la parola di offset nel piano selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "I/J円弧に選択平面のオフセットワードがありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У дуги I/J нет слова смещения в выбранной плоскости."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir I/J yayının seçili düzlemde ofset kelimesi eksik."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "I/J 圆弧在所选平面中缺少偏移字。"
          }
        }
      }
    },
    "An R-format arc had a geometry error.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ هندسي في قوس بصيغة R."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bogen im R-Format hatte einen Geometriefehler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arco en formato R tuvo un error de geometría."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un arco in formato R ha avuto un errore di geometria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "R形式の円弧でジオメトリエラーが発生しました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У дуги в формате R ошибка геометрии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "R biçimli bir yayda geometri hatası oluştu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "R 格式圆弧出现几何错误。"
          }
        }
      }
    },
    "An arc or probe target is impossible (e.g. the arc cannot be generated).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هدف القوس أو المجس مستحيل (مثلًا لا يمكن توليد القوس)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bogen- oder Antastziel ist unmöglich (z. B. kann der Bogen nicht erzeugt werden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un destino de arco o de palpado es imposible (p. ej., el arco no se puede generar)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un obiettivo di arco o tastatura è impossibile (es. l'arco non può essere generato)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "円弧またはプローブの目標が不可能です(例: 円弧を生成できない)。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель дуги или щупа невозможна (например, дугу нельзя построить)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yay veya prob hedefi imkânsız (ör. yay oluşturulamıyor)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆弧或探测目标不可能实现（例如无法生成圆弧）。"
          }
        }
      }
    },
    "An axis could not find its limit switch within the search distance.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يجد محور مفتاح نهايته ضمن مسافة البحث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Achse hat ihren Endschalter innerhalb der Suchstrecke nicht gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un eje no encontró su final de carrera dentro de la distancia de búsqueda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un asse non ha trovato il finecorsa entro la distanza di ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軸が探索距離内でリミットスイッチを見つけられませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ось не нашла концевик в пределах дистанции поиска."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir eksen arama mesafesi içinde limit switch'ini bulamadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个轴在搜索距离内未找到限位开关。"
          }
        }
      }
    },
    "Arc missing offset": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوس بلا إزاحة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogen ohne Versatz"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arco sin desplazamiento"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arco senza offset"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "円弧のオフセットなし"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуга без смещения"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayda ofset eksik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆弧缺少偏移"
          }
        }
      }
    },
    "Arc radius error": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ في نصف قطر القوس"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogenradiusfehler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de radio de arco"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Errore di raggio dell'arco"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "円弧半径エラー"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка радиуса дуги"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yay yarıçap hatası"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆弧半径错误"
          }
        }
      }
    },
    "Arc without axis words": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوس بلا كلمات محاور"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bogen ohne Achsworte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arco sin palabras de eje"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arco senza parole d'asse"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軸ワードのない円弧"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуга без слов осей"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksen kelimesiz yay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆弧没有轴字"
          }
        }
      }
    },
    "At that height the bit can catch clamps, screws, tabs or an uneven stock surface while moving at full speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هذا الارتفاع قد تعلق اللقمة بالمشابك أو البراغي أو الجسور أو سطح غير مستوٍ وهي تتحرك بأقصى سرعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Höhe kann der Fräser bei voller Geschwindigkeit Spannmittel, Schrauben, Haltestege oder eine unebene Oberfläche treffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A esa altura la fresa puede engancharse con bridas, tornillos, puentes o una superficie irregular mientras se mueve a toda velocidad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A quell'altezza la fresa può urtare morsetti, viti, ponticelli o una superficie irregolare muovendosi alla massima velocità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その高さでは、全速移動中にクランプ、ねじ、タブ、凹凸のある表面に引っかかる恐れがあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На такой высоте фреза может на полной скорости задеть прижимы, винты, перемычки или неровную поверхность."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yükseklikte uç tam hızda giderken kelepçelere, vidalara, köprülere veya düzgün olmayan yüzeye takılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此高度，刀具全速移动时可能碰到压板、螺丝、连接桥或不平的表面。"
          }
        }
      }
    },
    "Axis words were given while motion is cancelled (G80).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُعطيت كلمات محاور بينما الحركة ملغاة (G80)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achsworte wurden bei aufgehobener Bewegung (G80) angegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dieron palabras de eje con el movimiento cancelado (G80)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono state date parole d'asse con il movimento annullato (G80)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動がキャンセル(G80)された状態で軸ワードが指定されました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова осей заданы при отменённом движении (G80)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareket iptal edilmişken (G80) eksen kelimeleri verildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在运动已取消（G80）时给出了轴字。"
          }
        }
      }
    },
    "Bad number": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رقم خاطئ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige Zahl"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número incorrecto"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Numero errato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不正な数値"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверное число"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatalı sayı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字错误"
          }
        }
      }
    },
    "Build info or startup line exceeds the storage limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معلومات البناء أو سطر البدء يتجاوز حد التخزين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build-Info oder Startzeile überschreitet den Speicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información de compilación o la línea de inicio supera el límite de almacenamiento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le info di build o la riga di avvio superano il limite di memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルド情報またはスタートアップ行が保存上限を超えています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Информация о сборке или стартовая строка превышает лимит памяти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapı bilgisi veya başlangıç satırı depolama sınırını aşıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编译信息或启动行超出存储限制。"
          }
        }
      }
    },
    "Check the probe wiring for a short.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص أسلاك المجس بحثًا عن تماس."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Tasterverkabelung auf einen Kurzschluss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el cableado de la sonda por si hay un cortocircuito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il cablaggio della sonda per un cortocircuito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プローブ配線のショートを確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте проводку щупа на замыкание."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prob kablolamasında kısa devre olup olmadığını kontrol et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查探头线路是否短路。"
          }
        }
      }
    },
    "Check the reported line in Job › G-code text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص السطر المذكور في العمل › نص G-code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die gemeldete Zeile unter Job › G-Code-Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la línea indicada en Trabajo › Texto G-code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la riga segnalata in Lavoro › Testo G-code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業 › G-codeテキストで該当行を確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте указанную строку в разделе Работа › Текст G-code."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirilen satırı İş › G-code metni'nde kontrol et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 加工 › G 代码文本 中检查报告的行。"
          }
        }
      }
    },
    "Check the switch connectors on the controller — an unplugged switch is the most common cause.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص موصلات المفاتيح في وحدة التحكم — المفتاح المفصول هو السبب الأشيع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Schalterstecker an der Steuerung – ein abgezogener Schalter ist die häufigste Ursache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los conectores de los finales de carrera en el controlador: un interruptor desconectado es la causa más común."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i connettori dei finecorsa sul controller: un interruttore scollegato è la causa più comune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラのスイッチコネクタを確認してください。抜けたスイッチが最も多い原因です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте разъёмы концевиков на контроллере — чаще всего причина в отключённом концевике."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolcüdeki switch konnektörlerini kontrol et — en yaygın neden takılı olmayan bir switch'tir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查控制器上的开关接头 — 最常见的原因是开关未插好。"
          }
        }
      }
    },
    "Check the switch for a stuck lever or wiring that holds it closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص المفتاح بحثًا عن ذراع عالق أو أسلاك تبقيه مغلقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Schalter auf einen klemmenden Hebel oder eine Verdrahtung, die ihn geschlossen hält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa si el interruptor tiene la palanca atascada o un cableado que lo mantiene cerrado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla se l'interruttore ha una leva bloccata o un cablaggio che lo tiene chiuso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スイッチのレバーの引っかかりや、閉じたままにする配線がないか確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, не залип ли рычаг концевика и не держит ли его замкнутым проводка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch'te sıkışmış bir kol veya onu kapalı tutan bir kablo olup olmadığını kontrol et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查开关是否有卡住的拨杆或使其保持闭合的接线。"
          }
        }
      }
    },
    "Check where you set work zero: the job may extend past the end of travel from that point.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من مكان صفر القطعة: قد يتجاوز العمل نهاية مدى الحركة من تلك النقطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, wo du den Werkstücknullpunkt gesetzt hast: Der Job kann von dort aus über das Ende des Verfahrwegs reichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa dónde pusiste el cero de trabajo: el trabajo puede pasar del final del recorrido desde ese punto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla dove hai messo lo zero pezzo: il lavoro potrebbe superare la fine della corsa da quel punto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワーク原点の位置を確認してください。その点から作業がストローク端を超えている可能性があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, где вы задали ноль заготовки: от этой точки работа может выходить за конец хода."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş sıfırını nereye koyduğunu kontrol et: iş o noktadan hareket alanının sonunu aşıyor olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查你设置的工件零点：从该点起加工可能超出行程末端。"
          }
        }
      }
    },
    "Check whether the gantry really reached the end of travel, or a switch triggered from noise or a loose wire.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق إن كانت الجسرية قد وصلت فعلًا إلى نهاية المدى، أو أن المفتاح انطلق بسبب تشويش أو سلك مرتخٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob das Portal wirklich das Wegende erreicht hat oder ein Schalter durch Störungen oder ein lockeres Kabel ausgelöst hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si el pórtico llegó de verdad al final del recorrido o si un interruptor se disparó por ruido o un cable suelto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se il portale ha davvero raggiunto fine corsa o se un interruttore è scattato per disturbi o un filo allentato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガントリーが本当にストローク端に達したのか、ノイズや緩んだ配線でスイッチが作動したのか確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, действительно ли портал дошёл до конца хода, или концевик сработал от помех или плохого контакта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Köprünün gerçekten hareket sonuna gelip gelmediğini ya da switch'in parazit veya gevşek kablo yüzünden tetiklenip tetiklenmediğini kontrol et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认龙门是否真的到达行程末端，还是开关因干扰或松动的线而触发。"
          }
        }
      }
    },
    "Check your Z zero first. If it is right, set a safe retract height in your CAM and re-export so plunges use a G1 feed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من صفر Z أولًا. إن كان صحيحًا، اضبط ارتفاع رفع آمنًا في CAM وأعد التصدير لتكون حركات الغرز بتغذية G1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe zuerst deinen Z-Nullpunkt. Stimmt er, stelle im CAM eine sichere Rückzugshöhe ein und exportiere neu, damit Eintauchbewegungen mit G1-Vorschub laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa primero el cero de Z. Si es correcto, define una altura de retirada segura en tu CAM y vuelve a exportar para que las penetraciones usen avance G1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla prima lo zero Z. Se è giusto, imposta nel CAM un'altezza di risalita sicura e riesporta, così gli affondi usano un avanzamento G1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずZゼロを確認してください。正しければ、CAMで安全な退避高さを設定して再出力し、突っ込みをG1送りにしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала проверьте ноль Z. Если он верный, задайте в CAM безопасную высоту отвода и экспортируйте заново, чтобы врезания шли на подаче G1."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Z sıfırını kontrol et. Doğruysa CAM'de güvenli geri çekme yüksekliği ayarla ve yeniden dışa aktar; dalmalar G1 ilerlemesiyle yapılsın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先检查 Z 零点。如果正确，请在 CAM 中设置安全的抬刀高度并重新导出，让下刀使用 G1 进给。"
          }
        }
      }
    },
    "Clear the alarm first ($X to unlock, or home), then send again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح الإنذار أولًا ($X للفتح أو إرجاع للصفر)، ثم أرسل مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche zuerst den Alarm ($X zum Entsperren oder referenzieren), dann erneut senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra primero la alarma ($X para desbloquear, o haz homing) y vuelve a enviar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima cancella l'allarme ($X per sbloccare, o homing), poi invia di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずアラームを解除($Xでロック解除、または原点復帰)してから再送信してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала сбросьте аварию ($X для разблокировки или хоуминг), затем отправьте снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce alarmı temizle ($X ile kilidi aç veya referansa al), sonra tekrar gönder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先清除报警（$X 解锁或回零），然后重新发送。"
          }
        }
      }
    },
    "Close the enclosure door (or check the door switch wiring) and home again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق باب الغطاء (أو افحص أسلاك مفتاح الباب) وأعد الإرجاع للصفر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe die Gehäusetür (oder prüfe die Verdrahtung des Türschalters) und referenziere erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la puerta del cerramiento (o revisa el cableado del interruptor de puerta) y vuelve a hacer homing."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi la porta della cabina (o controlla il cablaggio dell'interruttore) e rifai l'homing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンクロージャーの扉を閉じ(または扉スイッチの配線を確認し)、再度原点復帰してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закройте дверь кожуха (или проверьте проводку датчика двери) и снова выполните хоуминг."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabin kapağını kapat (veya kapak switch kablolamasını kontrol et) ve tekrar referansa al."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关上防护罩门（或检查门开关接线），然后重新回零。"
          }
        }
      }
    },
    "Compare the file's size (Job › Stats) with your machine's travel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قارن حجم الملف (العمل › الإحصاءات) بمدى حركة آلتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche die Dateigröße (Job › Statistik) mit dem Verfahrweg deiner Maschine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara el tamaño del archivo (Trabajo › Estadísticas) con el recorrido de tu máquina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta la dimensione del file (Lavoro › Statistiche) con la corsa della macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルのサイズ(作業 › 統計)をマシンのストロークと比べてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравните размер файла (Работа › Статистика) с ходами станка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyanın boyutunu (İş › İstatistik) makinenin hareket alanıyla karşılaştır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件尺寸（加工 › 统计）与机器行程比较。"
          }
        }
      }
    },
    "Confirm the clip is attached and the plate is on the work surface under the bit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد أن المشبك مثبت وأن اللوحة على سطح العمل تحت اللقمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob die Klemme angebracht ist und die Platte unter dem Fräser auf dem Werkstück liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que la pinza está puesta y la placa está sobre la pieza bajo la fresa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che la pinzetta sia agganciata e la piastra sia sul pezzo sotto la fresa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップが取り付けられ、プレートがビットの下のワーク上にあることを確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что зажим закреплён, а пластина лежит на заготовке под фрезой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipsin takılı olduğunu ve plakanın ucun altında iş yüzeyinde olduğunu doğrula."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认夹子已夹好，探测板放在刀具下方的工件上。"
          }
        }
      }
    },
    "Conflicting commands": {
      "localizations": {
        "ar": {
