    "Unlock ($X), jog away from the switch, then re-home before cutting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح القفل ($X)، وحرّك بعيدًا عن المفتاح، ثم أرجع للصفر قبل القطع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren ($X), vom Schalter wegtippen, dann vor dem Fräsen neu referenzieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea ($X), aléjate del interruptor con jog y vuelve a hacer homing antes de cortar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca ($X), allontanati dall'interruttore in jog, poi rifai l'homing prima di tagliare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック解除($X)し、スイッチから離れるようジョグしてから、切削前に原点復帰してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте ($X), отведите ось от концевика и перед резанием выполните хоуминг."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilidi aç ($X), switch'ten uzaklaşacak şekilde jog yap, sonra kesmeden önce yeniden referansa al."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁（$X），点动离开开关，切削前重新回零。"
          }
        }
