          }
        }
      }
    },
    "The block contains a G-code command the controller does not support.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي المقطع على أمر G-code لا يدعمه المتحكم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
