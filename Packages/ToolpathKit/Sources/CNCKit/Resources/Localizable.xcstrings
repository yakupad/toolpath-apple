    "Drilling uses feed per revolution instead of chip load per tooth.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الثقب تُستخدم التغذية لكل دورة بدلًا من حمل الرايش لكل حد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Bohren gilt Vorschub pro Umdrehung statt Zahnvorschub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al taladrar se usa avance por vuelta en lugar de carga de viruta por filo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella foratura si usa l'avanzamento al giro invece del carico per tagliente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穴あけでは刃当たり送りではなく1回転あたりの送りを使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сверлении используется подача на оборот вместо нагрузки на зуб."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Delmede diş başına talaş yükü yerine devir başına ilerleme kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钻孔使用每转进给量，而不是每齿进给量。"
          }
        }
      }
    },
    "E-stop or second switch not found": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف الطوارئ أو لم يُعثر على المفتاح الثاني"
