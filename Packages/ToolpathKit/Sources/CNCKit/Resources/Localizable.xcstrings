          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloque contiene un comando G-code que el controlador no admite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco contiene un comando G-code non supportato dal controller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックにコントローラ非対応のG-codeコマンドが含まれています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
