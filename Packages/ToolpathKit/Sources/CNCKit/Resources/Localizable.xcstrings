    "Look for a stray character or a missing value on the reported line.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن حرف زائد أو قيمة مفقودة في السطر المذكور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche in der gemeldeten Zeile nach einem überzähligen Zeichen oder einem fehlenden Wert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca un carácter sobrante o un valor que falte en la línea indicada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca un carattere in più o un valore mancante nella riga segnalata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "該当行に余分な文字や欠けた値がないか探してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите лишний символ или отсутствующее значение в указанной строке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirilen satırda fazladan bir karakter veya eksik bir değer ara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在报告的行中查找多余字符或缺失的值。"
          }
        }
      }
    },
    "Low clearance on rapid moves": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلوص منخفض في الحركات السريعة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geringer Abstand bei Eilgängen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poca holgura en movimientos rápidos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanza ridotta nei movimenti rapidi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早送りのクリアランス不足"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало зазора на холостых ходах"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı hareketlerde düşük açıklık"
          }
        },
