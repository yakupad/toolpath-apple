    "Verify $130–$132 (max travel) match your machine.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من أن $130–$132 (أقصى مدى) تطابق آلتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, ob $130–$132 (max. Verfahrweg) zu deiner Maschine passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que $130–$132 (recorrido máximo) coinciden con tu máquina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che $130–$132 (corsa massima) corrispondano alla tua macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "$130〜$132(最大ストローク)がマシンと合っているか確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, что $130–$132 (макс. ход) соответствуют вашему станку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "$130–$132 (azami hareket) değerlerinin makinene uyduğunu doğrula."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认 $130–$132（最大行程）与你的机器相符。"
          }
        }
      }
    },
    "Watch which axis moves during homing; that is the one with the problem.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راقب أي محور يتحرك أثناء الإرجاع للصفر؛ فهو صاحب المشكلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachte, welche Achse sich bei der Referenzfahrt bewegt – die hat das Problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observa qué eje se mueve durante el homing: ese es el del problema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osserva quale asse si muove durante l'homing: è quello con il problema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原点復帰中にどの軸が動くか見てください。その軸に問題があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите, какая ось движется при хоуминге, — проблема в ней."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referanslama sırasında hangi eksenin hareket ettiğini izle; sorun o eksendedir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察回零时哪个轴在动 — 问题就出在那个轴。"
          }
        }
      }
    }
