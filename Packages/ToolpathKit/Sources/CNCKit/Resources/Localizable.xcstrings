    "G-code is locked out during an alarm or jog.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُقفل G-code أثناء الإنذار أو التحريك اليدوي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
