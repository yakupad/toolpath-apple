    "Run homing again and let it finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل الإرجاع للصفر مجددًا واتركه يكتمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
