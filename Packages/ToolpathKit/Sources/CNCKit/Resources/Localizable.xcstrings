    "Jog in the other direction or re-home so the controller knows where it is.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حرّك في الاتجاه المعاكس أو أعد الإرجاع للصفر ليعرف المتحكم موضعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in die andere Richtung oder referenziere neu, damit die Steuerung weiß, wo sie ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz jog en la otra dirección o vuelve a hacer homing para que el controlador sepa dónde está."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai jog nell'altra direzione o rifai l'homing perché il controller sappia dov'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "反対方向にジョグするか、コントローラが位置を把握できるよう再度原点復帰してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдвиньтесь в другую сторону или снова выполните хоуминг, чтобы контроллер знал, где он."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
