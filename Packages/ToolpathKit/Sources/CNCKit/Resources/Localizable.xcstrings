    "Line %lld is a rapid (G0) that drops from Z%@ to Z%@, below the stock top.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السطر %1$lld حركة سريعة (G0) تنزل من Z%2$@ إلى Z%3$@، تحت سطح الخامة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeile %1$lld ist ein Eilgang (G0), der von Z%2$@ auf Z%3$@ fällt, unter die Materialoberkante."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Line %1$lld is a rapid (G0) that drops from Z%2$@ to Z%3$@, below the stock top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea %1$lld es un rápido (G0) que baja de Z%2$@ a Z%3$@, por debajo de la superficie del material."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riga %1$lld è un rapido (G0) che scende da Z%2$@ a Z%3$@, sotto la superficie del materiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld行目は、Z%2$@からZ%3$@へ材料上面より下に下がる早送り(G0)です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка %1$lld — холостой ход (G0), опускающийся с Z%2$@ до Z%3$@, ниже верха заготовки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. satır, Z%2$@ değerinden Z%3$@ değerine, malzeme yüzeyinin altına inen hızlı (G0) bir hareket."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld 行是一个快速移动（G0），从 Z%2$@ 降到 Z%3$@，低于材料上表面。"
          }
        }
      }
    },
