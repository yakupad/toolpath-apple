// Copy to Config/Secrets.xcconfig (git-ignored) and fill in real values.
// Never commit the real file.

// Cloudflare Worker proxy base URL (no trailing slash).
// xcconfig treats "//" as a comment, so the URL is split around $().
WORKER_BASE_URL = https:/$()/example.workers.dev

// Shared app secret for the Worker (rotatable, low value — not a provider key).
APP_PROXY_SECRET = replace-me
