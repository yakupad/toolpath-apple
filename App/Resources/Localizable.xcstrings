    "Runs on your device with Apple Intelligence. Cutting numbers always come from the calculator.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل على جهازك باستخدام Apple Intelligence. قيم القطع تأتي دائمًا من الحاسبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft auf deinem Gerät mit Apple Intelligence. Schnittwerte kommen immer aus dem Rechner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona en tu dispositivo con Apple Intelligence. Los valores de corte siempre salen de la calculadora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona sul tuo dispositivo con Apple Intelligence. I valori di taglio arrivano sempre dal calcolatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceでデバイス上で動作。切削条件は常に計算機から算出されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает на устройстве с Apple Intelligence. Режимы резания всегда берутся из калькулятора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ile cihazında çalışır. Kesme değerleri her zaman hesaplayıcıdan gelir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "借助 Apple 智能在设备上运行。切削参数始终来自计算器。"
          }
        }
      }
    },
