    "Pre-flight and feeds use your own tools. Add more anytime in Library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم الفحص المسبق والتغذية أدواتك. أضف المزيد في أي وقت من المكتبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorab-Check und Schnittwerte nutzen deine eigenen Werkzeuge. Weitere jederzeit in der Bibliothek hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación previa y los avances usan tus propias herramientas. Añade más cuando quieras en Biblioteca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo preliminare e gli avanzamenti usano i tuoi utensili. Aggiungine altri quando vuoi in Libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事前チェックと送り計算はあなたの工具を使います。ライブラリでいつでも追加できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предстартовая проверка и подачи используют ваш инструмент. Добавляйте ещё в Библиотеке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön kontrol ve ilerleme hesapları kendi takımlarını kullanır. Kütüphane'den istediğin zaman ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
