          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已是 Pro — 谢谢！"
          }
        }
      }
    },
    "You've used this month's cloud questions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد استخدمت أسئلة هذا الشهر السحابية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Cloud-Fragen dieses Monats aufgebraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado las preguntas en la nube de este mes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai usato le domande cloud di questo mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月のクラウド質問を使い切りました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы использовали облачные вопросы этого месяца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ayın bulut sorularını kullandınız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已用完本月的云端提问。"
          }
        }
      }
    },
    "Your data syncs through your own private iCloud — no account needed. It's yours: export it any time as JSON or CSV.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة بياناتك عبر iCloud الخاص بك — دون حساب. بياناتك ملكك: صدّرها في أي وقت بصيغة JSON أو CSV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten werden über dein privates iCloud synchronisiert – ohne Konto. Sie gehören dir: exportiere sie jederzeit als JSON oder CSV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se sincronizan con tu iCloud privado, sin cuenta. Son tuyos: expórtalos cuando quieras en JSON o CSV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati si sincronizzano con il tuo iCloud privato, senza account. Sono tuoi: esportali quando vuoi in JSON o CSV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはあなた専用のiCloudで同期されます。アカウントは不要です。データはあなたのもの。いつでもJSONやCSVで書き出せます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные синхронизируются через ваш личный iCloud — без аккаунта. Они ваши: экспортируйте их в JSON или CSV в любой момент."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz kendi özel iCloud'unuzla senkronize olur — hesap gerekmez. Verileriniz sizindir: istediğiniz zaman JSON veya CSV olarak dışa aktarın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的数据通过你自己的私有 iCloud 同步，无需账户。数据归你所有：随时可导出为 JSON 或 CSV。"
          }
        }
      }
    },
    "Your last %lld runs were clean.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "آخر %lld تشغيلات كانت نظيفة."
