    "Position may be lost — re-home or re-zero before cutting.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون الموضع فُقد — أرجع إلى الصفر أو أعد التصفير قبل القطع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Position evtl. verloren – vor dem Fräsen referenzieren oder neu nullen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede haberse perdido la posición: haz homing o vuelve a poner cero antes de cortar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione potrebbe essere persa: fai l'homing o riazzera prima di tagliare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置がずれた可能性があります — 切削前に原点復帰または再ゼロ合わせを。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позиция могла сбиться — выполните хоуминг или заново обнулите перед резанием."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum kaybolmuş olabilir — kesmeden önce referansa al veya yeniden sıfırla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置可能丢失 — 切削前请回零或重新对零。"
          }
        }
      }
    },
