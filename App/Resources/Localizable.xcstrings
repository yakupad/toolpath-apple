    "Pro includes 150 cloud assistant questions a month, plus unlimited machines and recipes, PDF reports and maintenance reminders.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن Pro ‏150 سؤالًا شهريًا للمساعد السحابي، بالإضافة إلى ماكينات ووصفات بلا حدود وتقارير PDF وتذكيرات الصيانة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro enthält 150 Fragen an den Cloud-Assistenten pro Monat sowie unbegrenzt Maschinen und Rezepte, PDF-Berichte und Wartungserinnerungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro incluye 150 preguntas al asistente en la nube al mes, además de máquinas y recetas ilimitadas, informes PDF y recordatorios de mantenimiento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro include 150 domande al mese all'assistente cloud, più macchine e ricette illimitate, report PDF e promemoria di manutenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proには毎月150回のクラウドアシスタント質問、機械・レシピ無制限、PDFレポート、メンテナンス通知が含まれます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro включает 150 вопросов облачному ассистенту в месяц, а также станки и рецепты без лимита, PDF-отчёты и напоминания об обслуживании."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro; ayda 150 bulut asistan sorusu, sınırsız makine ve tarif, PDF raporlar ve bakım hatırlatmaları içerir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 包含每月 150 次云端助手提问，以及无限机床和配方、PDF 报告和保养提醒。"
          }
        }
      }
    },
