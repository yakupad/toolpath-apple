          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una llave olvidada en el plato sale despedida a toda velocidad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chiave lasciata nel mandrino viene scagliata a piena velocità."
          }
        },
        "ja": {
