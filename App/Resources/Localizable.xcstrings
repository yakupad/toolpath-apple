    "Very low — clamps or screws can be hit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منخفض جدًا — قد يصطدم بالمشابك أو البراغي."
          }
        },
        "de": {
          "stringUnit": {
