    "No account needed — your data stays on your devices and in your iCloud.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حاجة إلى حساب — تبقى بياناتك على أجهزتك وفي iCloud الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto nötig – deine Daten bleiben auf deinen Geräten und in deiner iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta: tus datos se quedan en tus dispositivos y en tu iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account: i tuoi dati restano sui tuoi dispositivi e nel tuo iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント不要 — データはあなたのデバイスとiCloudに保存されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта — данные остаются на ваших устройствах и в вашем iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap gerekmez — verilerin cihazlarında ve iCloud'unda kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户 — 数据保存在你的设备和你的 iCloud 中。"
          }
        }
      }
    },
