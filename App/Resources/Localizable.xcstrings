          "stringUnit": {
            "state": "translated",
            "value": "شغّل على ارتفاع 5–10 مم فوق الخامة وعمود الدوران متوقف وراقب الحركات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahre 5–10 mm über dem Material mit ausgeschalteter Spindel und beobachte die Bewegungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pásalo a 5–10 mm sobre el material con el husillo apagado y observa los movimientos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui a 5–10 mm sopra il materiale con il mandrino spento e osserva i movimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スピンドルを止めて材料の5〜10 mm上で走らせ、動きを確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите на 5–10 мм выше заготовки с выключенным шпинделем и понаблюдайте за перемещениями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş mili kapalıyken malzemenin 5–10 mm üstünde çalıştır ve hareketleri izle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭主轴，在材料上方 5–10 mm 运行并观察移动。"
          }
        }
      }
    },
