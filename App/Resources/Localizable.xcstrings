    "Seat it fully in the collet and tighten.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخلها حتى النهاية في المقبض وشدّها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganz in die Spannzange einsetzen und festziehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdúcela a fondo en la pinza y aprieta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inseriscila fino in fondo nella pinza e stringi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレットの奥まで差し込んで締めてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте до упора в цангу и затяните."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensete tam oturt ve sık."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全插入夹头并拧紧。"
          }
        }
      }
    },
