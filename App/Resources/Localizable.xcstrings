    "HSS turns at about 40% of carbide's surface speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخرط أدوات HSS بنحو 40٪ من سرعة القطع للكربيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HSS dreht mit etwa 40 % der Schnittgeschwindigkeit von Hartmetall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El HSS tornea a un 40 % de la velocidad de corte del metal duro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'HSS tornisce a circa il 40% della velocità di taglio del metallo duro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイスは超硬の約40%の切削速度で旋削します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрорез точит примерно на 40 % скорости резания твёрдого сплава."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HSS, karbürün yaklaşık %40'ı kesme hızında tornalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高速钢的车削速度约为硬质合金的 40%。"
