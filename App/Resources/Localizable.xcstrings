    "Log a few jobs with this recipe and Toolpath will suggest adjustments.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل بضعة أعمال بهذه الوصفة وسيقترح Toolpath تعديلات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolliere ein paar Jobs mit diesem Rezept, dann schlägt Toolpath Anpassungen vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra algunos trabajos con esta receta y Toolpath sugerirá ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra qualche lavoro con questa ricetta e Toolpath suggerirà modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレシピで何回か作業を記録すると、Toolpathが調整を提案します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите несколько работ с этим рецептом, и Toolpath предложит поправки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarifle birkaç iş kaydet, Toolpath ayar önerileri sunsun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用此配方记录几次加工，Toolpath 会给出调整建议。"
          }
        }
      }
    },
