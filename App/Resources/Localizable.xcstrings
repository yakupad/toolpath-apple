    "An insert above or below centre rubs and leaves a nub when facing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اللقمة الأعلى أو الأدنى من المركز تحتك وتترك نتوءًا عند تشغيل الوجه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Platte über oder unter Mitte reibt und lässt beim Plandrehen einen Zapfen stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una plaquita por encima o por debajo del centro roza y deja un pezón al refrentar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un inserto sopra o sotto il centro striscia e lascia un nocciolo in sfacciatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "芯高より上や下のチップはこすれて、端面加工でへそが残ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резец выше или ниже центра трёт и оставляет «пупок» при подрезке торца."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkezin üstünde ya da altında kalan kesici ucu sürtünür ve alın tornalamada ortada bir çıkıntı bırakır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刀片高于或低于中心会摩擦，端面车削时会留下凸台。"
          }
        }
      }
    },
