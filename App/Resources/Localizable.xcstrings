    "You're Pro — thank you!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبحت Pro — شكرًا لك!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist Pro – danke!"
          }
        },
        "es": {
