          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の材料"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свои материалы"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi malzemeleriniz"
          }
