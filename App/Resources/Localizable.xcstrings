    "Capped at your lathe's %@ RPM — the ideal speed for this small diameter is %@ RPM. Feed is recalculated from the capped speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محدود بسرعة مخرطتك %@ دورة/دقيقة — السرعة المثالية لهذا القطر الصغير %@ دورة/دقيقة. أُعيد حساب التغذية من السرعة المحدودة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die %@ U/min deiner Drehmaschine begrenzt – ideal wären für diesen kleinen Durchmesser %@ U/min. Der Vorschub wird aus der begrenzten Drehzahl neu berechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Capped at your lathe's %1$@ RPM — the ideal speed for this small diameter is %2$@ RPM. Feed is recalculated from the capped speed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitado a las %@ RPM de tu torno: la velocidad ideal para este diámetro pequeño es %@ RPM. El avance se recalcula con la velocidad limitada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitato ai %@ giri del tuo tornio: la velocità ideale per questo piccolo diametro è %@ giri. L'avanzamento è ricalcolato dalla velocità limitata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旋盤の上限 %@ rpm で制限されました。この小径に理想的な回転数は %@ rpm です。送りは制限後の回転数で再計算されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничено %@ об/мин вашего станка — для этого малого диаметра идеально %@ об/мин. Подача пересчитана по ограниченным оборотам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tornanızın %@ devir/dk sınırına takıldı — bu küçük çap için ideal hız %@ devir/dk. İlerleme sınırlanmış hıza göre yeniden hesaplandı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已限制为车床的 %@ 转/分——这个小直径的理想转速是 %@ 转/分。进给按限制后的转速重新计算。"
          }
        }
      }
    },
