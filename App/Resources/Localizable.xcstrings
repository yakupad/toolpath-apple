    "Explains a GRBL, grblHAL or FluidNC alarm or error code and what to check. Works offline.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشرح رمز إنذار أو خطأ GRBL أو grblHAL أو FluidNC وما يجب فحصه. يعمل دون اتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklärt einen GRBL-, grblHAL- oder FluidNC-Alarm- oder Fehlercode und was zu prüfen ist. Funktioniert offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica un código de alarma o error de GRBL, grblHAL o FluidNC y qué revisar. Funciona sin conexión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiega un codice di allarme o errore GRBL, grblHAL o FluidNC e cosa controllare. Funziona offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GRBL、grblHAL、FluidNCのアラーム・エラーコードと確認事項を説明します。オフラインで動作します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объясняет код аварии или ошибки GRBL, grblHAL или FluidNC и что проверить. Работает без интернета."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GRBL, grblHAL veya FluidNC alarm ya da hata kodunu ve neyin kontrol edileceğini açıklar. Çevrimdışı çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解释 GRBL、grblHAL 或 FluidNC 的报警或错误代码以及需要检查的内容。可离线使用。"
          }
        }
      }
    },
