    "A key left in the chuck is thrown at full speed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح الظرف المتروك يُقذف بالسرعة القصوى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
