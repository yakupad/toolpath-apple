    "Lower feed %lld%% and depth %lld%%, and check the zero and clamps before the next run.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خفّض التغذية بنسبة %lld %% والعمق بنسبة %lld %%، وتحقق من الصفر والمشابك قبل التشغيل التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senke Vorschub um %lld %% und Zustellung um %lld %% und prüfe Nullpunkt und Spannmittel vor dem nächsten Lauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Lower feed %1$lld%% and depth %2$lld%%, and check the zero and clamps before the next run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el avance un %lld %% y la profundidad un %lld %%, y revisa el cero y las bridas antes de la próxima pasada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci l'avanzamento del %lld %% e la profondità del %lld %% e controlla zero e morsetti prima della prossima lavorazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送りを%lld%%、切込みを%lld%%下げ、次の実行前にゼロ点とクランプを確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снизьте подачу на %lld %% и глубину на %lld %% и проверьте ноль и прижимы перед следующим запуском."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemeyi %%%1$lld, derinliği %%%2$lld düşür; bir sonraki çalışmadan önce sıfırı ve kelepçeleri kontrol et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将进给降低 %lld%%、切深降低 %lld%%，并在下次运行前检查零点和压板。"
          }
        }
      }
    },
