    "Jobs, machines, tools, recipes, stock and history are removed from this device and your iCloud. This can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف الأعمال والآلات والأدوات والوصفات والخامات والسجل من هذا الجهاز ومن iCloud الخاص بك. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jobs, Maschinen, Werkzeuge, Rezepte, Material und Verlauf werden von diesem Gerät und aus deiner iCloud gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borran trabajos, máquinas, herramientas, recetas, material e historial de este dispositivo y de tu iCloud. No se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavori, macchine, utensili, ricette, materiale e cronologia vengono rimossi da questo dispositivo e dal tuo iCloud. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業、マシン、工具、レシピ、材料、履歴がこのデバイスとiCloudから削除されます。元に戻せません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работы, станки, инструменты, рецепты, материалы и история удаляются с этого устройства и из вашего iCloud. Это нельзя отменить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşler, makineler, takımlar, tarifler, stok ve geçmiş bu cihazdan ve iCloud'undan silinir. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加工、机器、刀具、配方、库存和历史将从此设备和你的 iCloud 中删除。此操作无法撤销。"
          }
        }
      }
    },
    "Keep clamps %@ mm outside the path": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ المشابك على بعد %@ مم خارج المسار"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spannmittel %@ mm außerhalb der Bahn halten"
          }
