    "Add walnut, a plastic you use often, or anything not in the list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف خشب الجوز أو بلاستيكًا تستخدمه كثيرًا أو أي خامة غير موجودة في القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Nussbaum, einen oft genutzten Kunststoff oder etwas anderes hinzu, das nicht in der Liste steht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade nogal, un plástico que uses a menudo o cualquier cosa que no esté en la lista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi noce, una plastica che usi spesso o qualsiasi cosa non presente nell'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォルナット、よく使う樹脂など、一覧にない材料を追加できます。"
          }
        },
        "ru": {
          "stringUnit": {
