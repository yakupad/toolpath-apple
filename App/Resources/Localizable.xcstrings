    "See Warnings. Only continue if you know the file is right for your setup.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع التحذيرات. تابع فقط إن كنت متأكدًا أن الملف مناسب لتجهيزك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siehe Warnungen. Nur fortfahren, wenn die Datei sicher zu deinem Aufbau passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira las advertencias. Continúa solo si sabes que el archivo es correcto para tu montaje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi Avvisi. Continua solo se sai che il file è giusto per il tuo setup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告を確認してください。ファイルが段取りに合っていると確信できる場合のみ続行してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите «Предупреждения». Продолжайте, только если уверены, что файл подходит к вашей наладке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarılara bak. Dosyanın kurulumun için doğru olduğundan eminsen devam et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请查看警告。只有确认文件适合你的装夹时才继续。"
          }
        }
      }
    },
