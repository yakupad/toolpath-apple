    "We'll load its travel and spindle limits so every check fits your machine.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنحمّل مدى حركتها وحدود عمود الدوران لتناسب كل الفحوص آلتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir laden Verfahrweg und Spindelgrenzen, damit jede Prüfung zu deiner Maschine passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargaremos su recorrido y límites de husillo para que cada comprobación se ajuste a tu máquina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carichiamo corsa e limiti del mandrino, così ogni controllo si adatta alla tua macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストロークとスピンドルの上限を読み込み、すべてのチェックをあなたのマシンに合わせます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузим ходы и пределы шпинделя, чтобы каждая проверка соответствовала вашему станку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareket alanı ve iş mili sınırlarını yükleyelim, her kontrol makinene uysun."
