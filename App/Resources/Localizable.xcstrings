    "Start at %lld RPM and %lld millimeters per minute, up to %@ millimeters deep per pass. Make a test cut first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بسرعة %1$lld د/د و%2$lld مم في الدقيقة، وبعمق أقصاه %3$@ مم في كل مرور. اقطع تجربة أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit %1$lld U/min und %2$lld Millimetern pro Minute, höchstens %3$@ Millimeter tief pro Durchgang. Fräse zuerst einen Test."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Start at %1$lld RPM and %2$lld millimeters per minute, up to %3$@ millimeters deep per pass. Make a test cut first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con %1$lld RPM y %2$lld milímetros por minuto, hasta %3$@ milímetros de profundidad por pasada. Haz antes un corte de prueba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con %1$lld giri e %2$lld millimetri al minuto, fino a %3$@ millimetri di profondità per passata. Fai prima un taglio di prova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld rpm、毎分%2$lld ミリで開始し、1パスあたり最大%3$@ ミリの深さにしてください。まず試し削りを。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с %1$lld об/мин и %2$lld миллиметров в минуту, не глубже %3$@ миллиметра за проход. Сначала сделайте пробный проход."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld devir ve dakikada %2$lld milimetre ile başla, paso başına en fazla %3$@ milimetre derinlik. Önce deneme kesimi yap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 %1$lld 转/分、每分钟 %2$lld 毫米开始，每层最深 %3$@ 毫米。请先试切。"
          }
        }
      }
    },
