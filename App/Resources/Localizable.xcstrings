    "Limited to 50–150% of the base material. Raise values only after a successful test cut.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محدود بنسبة 50–150٪ من الخامة الأساسية. لا ترفع القيم إلا بعد قطع تجريبي ناجح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt auf 50–150 % des Basismaterials. Erhöhe Werte erst nach einem erfolgreichen Probeschnitt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitado al 50–150 % del material base. Sube los valores solo después de un corte de prueba correcto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitato al 50–150% del materiale di base. Aumenta i valori solo dopo un taglio di prova riuscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベース材料の50〜150%に制限されます。試し削りがうまくいってから値を上げてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничено 50–150 % от базового материала. Повышайте значения только после удачного пробного реза."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel malzemenin %50–150'si ile sınırlıdır. Değerleri yalnızca başarılı bir deneme kesiminden sonra artırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制在基础材料的 50–150%。请在试切成功后再提高数值。"
          }
        }
      }
    },
