          "stringUnit": {
            "state": "new",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld of your last 3 runs burned. Lower spindle speed %lld%% so each tooth takes a bigger chip.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ظهرت آثار احتراق في %lld من آخر 3 تشغيلات. خفّض السرعة الدورانية بنسبة %lld %% ليأخذ كل حدّ رايشًا أكبر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld deiner letzten 3 Läufe hatten Brandspuren. Senke die Drehzahl um %lld %%, damit jede Schneide einen größeren Span nimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of your last 3 runs burned. Lower spindle speed %2$lld%% so each tooth takes a bigger chip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de tus últimas 3 pasadas se quemaron. Baja las RPM un %lld %% para que cada filo tome una viruta mayor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld delle ultime 3 lavorazioni hanno bruciato. Riduci i giri del %lld %% così ogni tagliente prende un truciolo più grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近3回のうち%lld回で焼けが出ました。各刃がより厚い切りくずを取るよう、回転数を%lld%%下げてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %lld из последних 3 запусков были подгары. Снизьте обороты на %lld %%, чтобы каждый зуб снимал более толстую стружку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 3 çalışmanın %1$lld tanesinde yanık oldu. Her diş daha büyük talaş alsın diye iş mili devrini %%%2$lld düşür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 3 次中有 %lld 次出现烧焦。将转速降低 %lld%%，让每个刃切下更厚的切屑。"
          }
        }
      }
    },
    "%lld of your last 3 runs chattered. Lower feed %lld%% and depth %lld%%. Also check stickout and workholding.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ظهر اهتزاز في %lld من آخر 3 تشغيلات. خفّض التغذية بنسبة %lld %% والعمق بنسبة %lld %%. وتحقق أيضًا من طول البروز وتثبيت القطعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld deiner letzten 3 Läufe hatten Rattern. Senke Vorschub um %lld %% und Zustellung um %lld %%. Prüfe auch Auskraglänge und Spannung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of your last 3 runs chattered. Lower feed %2$lld%% and depth %3$lld%%. Also check stickout and workholding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de tus últimas 3 pasadas vibraron. Baja el avance un %lld %% y la profundidad un %lld %%. Revisa también el voladizo y la sujeción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld delle ultime 3 lavorazioni hanno vibrato. Riduci l'avanzamento del %lld %% e la profondità del %lld %%. Controlla anche sporgenza e bloccaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近3回のうち%lld回でびびりが出ました。送りを%lld%%、切込みを%lld%%下げてください。突き出し量と固定も確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %lld из последних 3 запусков была вибрация. Снизьте подачу на %lld %% и глубину на %lld %%. Проверьте также вылет и крепление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 3 çalışmanın %1$lld tanesinde titreşim oldu. İlerlemeyi %%%2$lld, derinliği %%%3$lld düşür. Takım çıkıntısını ve bağlamayı da kontrol et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 3 次中有 %lld 次出现振刀。将进给降低 %lld%%、切深降低 %lld%%。同时检查伸出长度和装夹。"
          }
        }
      }
    },
    "%lld of your last 3 runs were rough. Lower stepover %lld%% and feed %lld%%.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان السطح خشنًا في %lld من آخر 3 تشغيلات. خفّض الخطوة الجانبية بنسبة %lld %% والتغذية بنسبة %lld %%."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld deiner letzten 3 Läufe waren rau. Senke Bahnabstand um %lld %% und Vorschub um %lld %%."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of your last 3 runs were rough. Lower stepover %2$lld%% and feed %3$lld%%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de tus últimas 3 pasadas quedaron rugosas. Baja el paso lateral un %lld %% y el avance un %lld %%."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld delle ultime 3 lavorazioni sono uscite ruvide. Riduci il passo laterale del %lld %% e l'avanzamento del %lld %%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近3回のうち%lld回で仕上げが粗くなりました。ステップオーバーを%lld%%、送りを%lld%%下げてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %lld из последних 3 запусков поверхность была грубой. Снизьте шаг на %lld %% и подачу на %lld %%."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 3 çalışmanın %1$lld tanesinde yüzey kaba çıktı. Yan kaymayı %%%2$lld, ilerlemeyi %%%3$lld düşür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 3 次中有 %lld 次表面粗糙。将步距降低 %lld%%、进给降低 %lld%%。"
          }
        }
      }
    },
    "%lld required checks left": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقّى %lld من الفحوص الإلزامية"
          }
        },
