    "Conservative starting RPM and feed rate for a cut, from Toolpath's calculator.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سرعة دورانية وتغذية بداية متحفظة لقطع، من حاسبة Toolpath."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorsichtige Start-Drehzahl und Vorschub für einen Schnitt, aus dem Toolpath-Rechner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RPM y avance iniciales prudentes para un corte, de la calculadora de Toolpath."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giri e avanzamento iniziali prudenti per un taglio, dal calcolatore di Toolpath."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolpathの計算機による、切削の控えめな開始回転数と送り。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осторожные стартовые обороты и подача для прохода из калькулятора Toolpath."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolpath hesaplayıcısından bir kesim için temkinli başlangıç devri ve ilerleme hızı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 Toolpath 计算器的保守起始转速和进给。"
          }
        }
      }
    },
    "Conservative values for hobby lathes. Test, then adjust in small steps.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيم متحفظة لمخارط الهواة. جرّب ثم عدّل بخطوات صغيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorsichtige Werte für Hobby-Drehmaschinen. Testen, dann in kleinen Schritten anpassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores conservadores para tornos de hobby. Prueba y ajusta en pasos pequeños."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valori prudenti per torni hobbistici. Prova, poi regola a piccoli passi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホビー旋盤向けの控えめな値です。試してから少しずつ調整してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осторожные значения для любительских токарных станков. Проверьте и корректируйте небольшими шагами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hobi tornaları için temkinli değerler. Deneyin, sonra küçük adımlarla ayarlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于业余车床的保守数值。先试切，再小幅调整。"
          }
        }
      }
    },
