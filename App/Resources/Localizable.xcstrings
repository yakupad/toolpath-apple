    "Cuts go below Z0, so Z0 must be the stock surface.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القطوع تنزل تحت Z0، لذا يجب أن يكون Z0 هو سطح الخامة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnitte gehen unter Z0, also muss Z0 die Materialoberfläche sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cortes bajan de Z0, así que Z0 debe ser la superficie del material."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tagli scendono sotto Z0, quindi Z0 deve essere la superficie del materiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切削がZ0より下に入るので、Z0は材料の上面です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
