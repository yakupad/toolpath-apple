        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén las bridas a %@ mm fuera de la trayectoria"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni i morsetti a %@ mm fuori dal percorso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クランプを経路の外側%@ mmに"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите прижимы на %@ мм за пределами траектории"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelepçeleri yolun %@ mm dışında tut"
          }
