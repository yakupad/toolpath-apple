    "Your own materials": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خاماتك الخاصة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene Materialien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus propios materiales"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
