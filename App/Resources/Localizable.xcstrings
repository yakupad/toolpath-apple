            "value": "Inserisci l'indirizzo del controller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラのアドレスを入力してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите адрес контроллера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolcünün adresini girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入控制器的地址。"
          }
        }
      }
    },
