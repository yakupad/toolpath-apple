    "Moves closer than 0.5 mm to the jaws are flagged as dangerous.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعلَّم الحركات الأقرب من 0.5 مم إلى الفكوك على أنها خطرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewegungen näher als 0,5 mm an den Backen werden als gefährlich markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los movimientos a menos de 0,5 mm de las garras se marcan como peligrosos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I movimenti a meno di 0,5 mm dalle griffe sono segnalati come pericolosi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "爪から0.5 mm以内に近づく動きは危険として表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движения ближе 0,5 мм к кулачкам отмечаются как опасные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynaya 0,5 mm'den fazla yaklaşan hareketler tehlikeli olarak işaretlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距卡爪不足 0.5 mm 的动作会被标为危险。"
          }
        }
      }
    },
