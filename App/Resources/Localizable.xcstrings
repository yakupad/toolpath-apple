    "Every move passed the safety checks. Still run the pre-flight before you cut.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجتازت كل الحركات فحوص السلامة. ومع ذلك نفّذ الفحص المسبق قبل القطع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Bewegung hat die Sicherheitsprüfungen bestanden. Mach trotzdem den Vorab-Check, bevor du fräst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los movimientos pasaron las comprobaciones. Aun así, haz la comprobación previa antes de cortar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i movimenti hanno superato i controlli. Fai comunque il controllo preliminare prima di tagliare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての移動が安全チェックに合格しました。それでも切削前に事前チェックを行ってください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все перемещения прошли проверки. И всё же выполните предстартовую проверку перед резанием."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm hareketler güvenlik kontrollerinden geçti. Yine de kesmeden önce ön kontrolü yap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有移动都通过了安全检查。切削前仍请完成开机前检查。"
          }
        }
      }
    },
