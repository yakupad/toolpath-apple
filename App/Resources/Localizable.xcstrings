    "Enter how far the stock sticks out so Toolpath can check every move against the chuck. 0 = not set.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مقدار بروز الخامة حتى يتحقق Toolpath من كل حركة مقابل الظرف. 0 = غير محدد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib an, wie weit das Material aus dem Futter ragt, damit Toolpath jede Bewegung gegen das Futter prüfen kann. 0 = nicht gesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica cuánto sobresale el material para que Toolpath compruebe cada movimiento contra el plato. 0 = sin definir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica quanto sporge il pezzo così Toolpath può controllare ogni movimento rispetto al mandrino. 0 = non impostato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料のチャックからの突き出し量を入力すると、Toolpathがすべての動きをチャックと照合できます。0 = 未設定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите вылет заготовки из кулачков, чтобы Toolpath проверял каждое движение относительно патрона. 0 = не задано."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolpath'in her hareketi aynaya göre kontrol edebilmesi için stokun ne kadar dışarıda olduğunu girin. 0 = ayarlanmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入材料伸出卡盘的长度，Toolpath 就能检查每个动作与卡盘的距离。0 = 未设置。"
          }
        }
      }
    },
    "Enter the controller's address.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عنوان وحدة التحكم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Adresse des Controllers ein."
          }
        },
        "es": {
