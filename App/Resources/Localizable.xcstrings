    "All cuts stay above Z0, so Z0 must be the bed under the stock.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل القطوع فوق Z0، لذا يجب أن يكون Z0 هو الطاولة تحت الخامة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Schnitte bleiben über Z0, also muss Z0 der Tisch unter dem Material sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los cortes quedan por encima de Z0, así que Z0 debe ser la mesa bajo el material."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tagli restano sopra Z0, quindi Z0 deve essere il piano sotto il materiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての切削がZ0より上なので、Z0は材料の下のテーブル面です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все проходы выше Z0, значит Z0 — это стол под заготовкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kesimler Z0'ın üstünde, yani Z0 malzemenin altındaki tabla olmalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有切削都在 Z0 之上，所以 Z0 应是材料下方的台面。"
          }
        }
      }
    },
