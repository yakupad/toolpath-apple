    "Very low — clamps or screws can be hit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "منخفض جدًا — قد يصطدم بالمشابك أو البراغي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr niedrig – Spannmittel oder Schrauben können getroffen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muy bajo: puede golpear bridas o tornillos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Molto basso: può urtare morsetti o viti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非常に低い — クランプやねじに当たる恐れがあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очень низко — можно задеть прижимы или винты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok alçak — kelepçe veya vidalara çarpabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非常低 — 可能撞到压板或螺丝。"
          }
        }
      }
    },
